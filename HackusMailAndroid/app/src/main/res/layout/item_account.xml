<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_badge"
    android:layout_marginVertical="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvItemStatus"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="3dp"
        android:text="VALID"
        android:textColor="@color/status_good"
        android:textSize="9sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="user@domain.com:password"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="imap.domain.com:993"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Hits Badge if any -->
    <TextView
        android:id="@+id/tvItemHits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/status_hits_bg"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="2 Hits"
        android:textColor="@color/status_hits"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
