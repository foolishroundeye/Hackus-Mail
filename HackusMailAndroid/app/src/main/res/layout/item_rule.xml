<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_badge"
    android:layout_marginVertical="3dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRuleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rule Name"
            android:textColor="@color/primary_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRuleCriteria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="From: steampowered.com | Subj: order"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchRuleEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true" />

    <ImageButton
        android:id="@+id/btnDeleteRule"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_stop" />

</LinearLayout>
